# --- Ollama (local model) ---
OLLAMA_HOST_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.6
# CPU inference takes 5 to 9 minutes per reply; 300s made every reply time out once.
OLLAMA_TIMEOUT_SECONDS=600

# --- Business ---
UPLOAD_LINK=https://link.pinnaclepointfinancial.com/60nuNy

# Follow-up nudges are OFF until launch. The conversations table still holds
# test rows (including a real colleague's number saved under a test name), and
# with Text Torrent connected those would each get a real "Walter again" text.
# Clear the test rows, then set this to 1 on go-live day.
FOLLOWUP_ENABLED=0

# --- AWS (from the deployed "automessenger" stack in us-east-2) ---
AWS_REGION=us-east-2
INBOUND_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/870730509769/automessenger-inbound
OUTBOUND_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/870730509769/automessenger-outbound
CONVERSATIONS_TABLE=automessenger-conversations
ESCALATIONS_TOPIC_ARN=arn:aws:sns:us-east-2:870730509769:automessenger-escalations

# Scoped IAM user (automessenger-worker) created by the stack.
AWS_ACCESS_KEY_ID=AKIA4VO4VFXEV7CTDUU3
