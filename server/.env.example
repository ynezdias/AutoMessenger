# Copy this file to server/.env and fill in real values.

# --- Ollama (local model) ---
OLLAMA_HOST_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.6

# --- Business ---
# The secure statement upload page you give merchants. REQUIRED before going live.
UPLOAD_LINK=https://your-upload-page.example.com/upload

# --- AWS (values come from the CloudFormation stack outputs) ---
AWS_REGION=us-east-2
INBOUND_QUEUE_URL=
OUTBOUND_QUEUE_URL=
CONVERSATIONS_TABLE=
ESCALATIONS_TOPIC_ARN=

# Credentials: use `aws configure` on this machine, or set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here for a dedicated IAM user.
